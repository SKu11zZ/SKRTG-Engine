{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SKu11zZ/SKRTG-Engine/schemas/skrtg.character_mesh_selection.v1.schema.json",
  "title": "SKRTG Character Mesh selection v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schemaVersion", "activeLod", "meshNodePaths"],
  "properties": {
    "schema": { "const": "skrtg.character_mesh_selection.v1" },
    "schemaVersion": { "const": 1 },
    "activeLod": { "type": "integer", "minimum": 0, "maximum": 255 },
    "meshNodePaths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096,
        "pattern": "^(?!/)(?!.*//)(?!.*\\\\)[^\\u0000-\\u001F]+$"
      }
    }
  }
}
